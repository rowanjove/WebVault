# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure markdown, typescript, rust and configs are UTF-8
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.exe binary
*.msi binary
*.warc binary
*.warc.gz binary
*.wacz binary
*.db binary
